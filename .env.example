# ============================================================
# VULNCLAW 渗透测试平台 - 环境变量模板（v103）
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿提交）
#   cp .env.example .env
# 也可运行 python tools_menu.py 交互式配置
# 本文件由 core/settings.py 的 Settings 字段推导，全部可配置项见下。
# 除特殊标注外，均可省略——省略时使用注释中的默认值。
# ============================================================

# ===== 基础配置 =====
# 默认扫描目标（可被命令行 -t/--target 覆盖；留空则必须用 -t 指定）
#TARGET=
# 输出报告目录
#OUTPUT_DIR=_runtime_cache/reports
# 调试模式（更多日志输出）
#DEBUG=false
# 合规模式开关
#COMPLIANT=false

# ===== 网络与性能 =====
# 初始请求速率 RPS（自适应限流会动态调整）
#RPS=2.0
# 单请求超时（秒）
#TIMEOUT=30
# 最大并发数
#MAX_CONCURRENT=10
# HTTP 代理（可选，可被命令行 --proxy 覆盖），如 http://127.0.0.1:8080
# # PROXY 配为 Burp 桥代理可将代理历史喂给扫描器（127.0.0.1/localhost 自动绕过）；不启动 Burp 时注释本行直连
#PROXY=
# 代理列表（JSON 数组或逗号分隔），自动轮换
#PROXY_LIST=[]
# 单目标最大扫描时长（秒）
#MAX_SCAN_TIME=3600
# E5.1 scope 硬约束白名单（逗号分隔：example.com 匹配自身及子域；*.*.example.com 通配；10.0.0.0/8 CIDR；精确 IP）
#ALLOWED_SCOPE=

# ===== 请求头 =====
# 默认 User-Agent
#USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36
# 附加请求头（JSON，如 {"X-Custom":"1"}）
#EXTRA_HEADERS={}

# ===== AI 模型配置 =====
# 模型别名 → 实际模型名（JSON，注意不要有尾逗号）
#AI_MODEL_ALIASES={"1":"glm-4-flash","2":"qwen-plus-2025-07-28","4":"deepseek-ai/DeepSeek-V3.1-Terminus","5":"glm-4.7"}
# 各 provider 的 api_key / base_url（JSON）
#AI_MODEL_CONFIGS={"glm-4-flash":{"api_key":"your_api_key_here","base_url":"https://open.bigmodel.cn/api/paas/v4/"}}
# AI 档位（AI_MODE）：0~4 五种模式，一句话控制用几个 AI
#   AI_MODE=0 → 纯引擎模式：不调用任何 AI，扫描照常执行（AI 增强自动降级）
#   AI_MODE=1 → 单模型（省成本）；AI_MODE=2/3 → 双/三模型
#   AI_MODE=4 → 四模型全量交叉验证（默认）
#   未设置 AI_MODE → 使用 AI_MODELS 全部
#AI_MODE=4
# 启用哪些模型（用别名，可自定义任意数量/新别名，需同时在 AI_MODEL_ALIASES 中定义）
#AI_MODELS=["1","2","4","5"]
# 任务→模型分配（JSON，可选）
#AI_TASK_ALLOCATION={}
# 单次 AI 调用超时（秒）
#AI_TIMEOUT=300
# 默认模型池（AI_MODELS 未配置时使用；模型名支持 1/2/4/5 别名或全名，任意数量）
#DEFAULT_AI_MODEL_CODES=["1","2","4","5"]
# A4.4 任务分层模型路由：便宜模型粗筛/分类，贵模型验证/计划（复用 AI_MODE 档位 + provider_failover）
#MODEL_TIER_ROUTING=true
# 便宜快模型码（粗筛/分类）
#TIER_CHEAP_CODES=["1","2"]
# 贵模型码（验证/计划）
#TIER_EXPENSIVE_CODES=["4","5"]

# ===== 远程 AI Agent 接入（0~N 个，统一抽象；与本地 AI_MODELS 互补） =====
# JSON 数组，可配置任意数量（0 个=不启用远程委派，扫描行为不变）
#   type=mcp + transport=http  → 平台作为 MCP 客户端连接远程 MCP HTTP Server（标准协议，推荐）
#   type=mcp + transport=stdio → 启动本地/容器 MCP Server 子进程，stdin/stdout 走 JSON-RPC
#   type=mcp + transport=sse   → MCP 2024-11-05 SSE transport（兼容旧实现）
#   type=http                  → 远程 Agent 的 HTTP / OpenAI 兼容 chat/completions 接口
#   type=cli                   → 外部 Agent CLI 子进程（command 含 {prompt} 占位符，或从 stdin 读取）
# 安全默认：非本机地址必须带 token，否则该 Agent 忽略；HTTPS 证书校验默认开启；
#           每次委派有超时+熔断，Agent 不可用自动回退本地逻辑，不影响扫描。
# 示例（本机 MCP HTTP Agent，可免 token）：
#REMOTE_AGENTS=[{"name":"codex-http","type":"mcp","transport":"http","url":"http://127.0.0.1:8765/mcp","tool":"analyze"}]
# 示例（本地 MCP stdio Agent）：
#REMOTE_AGENTS=[{"name":"codex-stdio","type":"mcp","transport":"stdio","command":"python","args":["scripts/mcp_agent.py"],"tool":"analyze"}]
# 示例（本机 MCP SSE Agent，可免 token）：
#REMOTE_AGENTS=[{"name":"codex-sse","type":"mcp","transport":"sse","url":"http://127.0.0.1:8765/sse","tool":"analyze"}]
# 示例（远程 HTTP Agent，必须带 token）：
#REMOTE_AGENTS=[{"name":"remote-helper","type":"http","url":"https://agent.example.com/v1","token":"your_token_here","model":"deepseek-v3"}]
# 示例（CLI Agent）：
#REMOTE_AGENTS=[{"name":"cli-helper","type":"cli","command":"python scripts/agent_cli.py --prompt {prompt}"}]
# 远程委派超时（秒，单次调用上限 600）
#REMOTE_AGENT_TIMEOUT=60
# 任务委派路由：{"本地工具名": "远程 Agent 名"}。未指定 Agent 名时用首个可用 Agent。
# 路由到的工具调用会先过 DangerGuard（remote_task_execution），默认 deny。
#REMOTE_TASK_ROUTING={"nuclei":"remote-agent","ffuf":"remote-agent"}
# 远程深度渗透总开关（scan.deep_remote 工具）。默认开启；实际攻击仍需 DANGEROUS_ALLOW=remote_deep_penetrate 或 DANGEROUS_MODE=allow。
#REMOTE_DEEP_ENABLED=true

# ===== AI Provider（单模型快捷方式，与 AI_MODEL_CONFIGS 二选一） =====
# 注意：模板占位 Key（your_api_key_here）会导致 401 认证失败并熔断 Provider，
# 请务必替换为真实 Key；无 AI 需求时可直接设置 AI_MODE=0 走纯引擎模式。
AI_PROVIDER=zhipu
#AI_API_KEY=your_api_key_here
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ===== Provider 故障转移（按顺序尝试，首个可用为止） =====
#PROVIDER_PRIORITY=["zhipu","aliyun","siliconflow"]

# ===== 自适应并发（Sprint 1） =====
#ADAPTIVE_CONCURRENCY_INITIAL=3
#ADAPTIVE_CONCURRENCY_MIN=1
#ADAPTIVE_CONCURRENCY_MAX=20

# ===== Agent 行为（硬编码参数改为 env 读取） =====
# WAF 绕过开关
#ENABLE_WAF_BYPASS=true
# 单个 Agent 最大迭代次数
#AGENT_MAX_ITERATIONS=15
# 单参数最大失败次数
#AGENT_MAX_FAILURES_PER_PARAM=3
# 连续失败阈值（触发降级）
#AGENT_CONSECUTIVE_FAILURES_THRESHOLD=6
# 目录/路径爆破最大条数
#MAX_PATHS=150

# ===== Burp 集成 =====
#BURP_API_URL=http://127.0.0.1:1337
#BURP_API_KEY=

# ===== 工具路径 =====
# thirdparty 工具根目录
#THIRDPARTY_DIR=thirdparty
# Nuclei 模板目录（缺失时 CVE 扫描降级）
#NUCLEI_TEMPLATE_DIR=~/nuclei-templates
# 第三方工具缺失时启动自动安装（默认开，GitHub 不通静默跳过）
#TOOL_AUTO_INSTALL=true
# GitHub 直连失败时的镜像前缀（逗号分隔，镜像 URL=前缀+原始完整 URL；空=仅直连）
#TOOL_DOWNLOAD_MIRRORS=https://gh-proxy.com/,https://ghproxy.net/
# 单个工具下载重试轮数（每轮遍历 直连+全部镜像）
#TOOL_DOWNLOAD_RETRIES=3

# ===== 目录爆破字典 =====
# 内置 200+ 条 OWASP 常见路径，一般无需配置；如需覆盖用 JSON 数组
#COMMON_DIRS=["admin","login","api/v1","swagger","backup",".git/HEAD"]
# 或指定外部字典文件（存在时会与内置字典合并去重），每行一个路径
#DIRECTORY_DICT_PATH=/path/to/dirs.txt

# ===== 端口扫描 =====
#PORT_SCAN_TOOL=nmap
#PORT_SCAN_PORTS=80,443,8080,8443,3000,5000,7000,8000,9000,3306,5432,6379,9200,27017
#PORT_SCAN_RATE=1000

# ===== 缓存 =====
#CACHE_BACKEND=memory
#CACHE_TTL=7200

# ===== 监控与告警 =====
# 告警 Webhook（可选）
#ALERT_WEBHOOK=
# 指标开关
#ENABLE_METRICS=true
# 最大响应体积（MB，超限截断）
#MAX_RESPONSE_SIZE_MB=50

# ===== 插件市场与通知（Sprint 1） =====
#PLUGIN_DIR=thirdparty/plugins
#PLUGIN_MARKET_REPO=vulnclaw/plugins


# ===== 分布式配置（scan.py --distributed --master/--worker 时使用） =====
REDIS_URL=redis://localhost:6379/0
#MASTER_HOST=0.0.0.0
#MASTER_PORT=8080
#WORKER_COUNT=2

# ===== Dashboard 配置（预留） =====
#DASHBOARD_HOST=0.0.0.0
#DASHBOARD_PORT=8080

# ===== 高级联动（可选，默认关闭/降级） =====
# 情报模块（Shodan / Censys，缺 Key 自动降级）
#INTEL_ENABLED=true
#SHODAN_API_KEY=
#CENSYS_API_ID=
#CENSYS_API_SECRET=
#INTEL_TIMEOUT=15

# Metasploit RPC 深度利用联动（仅 severity=Critical 且 --dangerous 才触发）
#MSF_RPC_HOST=127.0.0.1
#MSF_RPC_PORT=55552
#MSF_RPC_USER=msf
#MSF_RPC_PASSWORD=
#MSF_RPC_SSL=false
#MSF_RPC_TIMEOUT=30
#MSF_AUTO_CONFIRM=true

# Nuclei 模板自动更新 & 按技术栈过滤标签
#NUCLEI_AUTO_UPDATE=true
#NUCLEI_TAGS_FROM_STACK=true

# SQLMap REST API 联动（守护进程自动启停）
#SQLMAP_API_URL=http://127.0.0.1:8775
#SQLMAP_API_AUTOSTART=true
# SQLi 检出后 sqlmap 轻量确认（POC 级，不提取数据），把引擎检出升级为实锤
#SQLI_SQLMAP_CONFIRM=true
# 实锤后最小化数据提取（仅 DBMS banner/当前库名/当前用户，不导出业务数据表）
#SQLI_SQLMAP_EXTRACT=true

# 告警卡片（飞书/企业微信/钉钉）
#ALERT_CARD_ENABLED=true
#ALERT_AT_ALL_ON_CRITICAL=true
# XSS 浏览器执行验证（headless 加载 PoC 确认真正可执行，而非仅反射判定）
#XSS_BROWSER_VERIFY=true
#XSS_BROWSER_TIMEOUT=15

# 性能优化开关（默认已启用，调试时可关）
#VERIFY_BATCH_AI=true
#SQLI_FAST_FAIL=true
#REPORT_INCLUDE_COOKIE=true
#HTTP2=true
#METRICS_PORT=9090

# ===== 安全配置 =====
# 危险模式总开关（--dangerous 需显式传参，此处为二级保险）
#DANGEROUS_MODE=false
# 在 deny 模式下单独放行的操作，逗号分隔（如 DANGEROUS_ALLOW="exploit_verify"）
#DANGEROUS_ALLOW=
# G5 危险操作三级分级：deny 时 write/destructive 默认拦截，下列开关可分别放行（需 --dangerous 配合）
#DANGER_LEVEL_WRITE_ALLOW=false
#DANGER_LEVEL_DESTRUCTIVE_ALLOW=false

# ===== SP 新增字段（v103+） =====
# ---- SP24 通用超时/批大小（原散落各模块的硬编码字面量统一收口） ----
# 单次 HTTP 请求超时（秒，原 async_get/async_post 硬编码 10/30）
#REQUEST_TIMEOUT=10
# AI 模型调用超时（秒，verify 档）
#AI_CALL_TIMEOUT=300
# 长推理超时（秒，plan/长上下文文档）
#MODEL_CALL_TIMEOUT_LONG=3600
# 远程/委派分析单次超时（秒）
#AI_DELEGATE_TIMEOUT=25
# 分层路由/候选粗筛超时（秒）
#AI_ROUTER_TIMEOUT=90
# AI 批处理大小（BatchProcessor）
#AI_BATCH_SIZE=5
# 外部工具子进程超时（秒）
#SUBPROCESS_TIMEOUT=30
# 流式落盘最终冲刷超时（秒）
#CHAIN_FLUSH_TIMEOUT=900
# OOB 域名申请超时（秒）
#OOB_DOMAIN_TIMEOUT=20
# OOB 轮询超时（秒）
#OOB_POLL_TIMEOUT=10

# ---- B 堆新增引擎开关（可选，默认启用） ----
# 口令重置枚举引擎
#PASSWORD_RESET=true
# 云容器/对象存储暴露引擎
#CLOUD_CONTAINER_EXPOSURE=true
# 后端组件 CVE 匹配引擎
#BACKEND_COMPONENT_CVE=true

# ---- 智能体编排（A2/A4/S1/S2/S3/Z3/P2/P3/P5） ----
# 深挖改用多 Agent 角色化编排
#ENABLE_AGENT_ROLES=true
#MULTI_AGENT_MAX_PARAMS=1
#MULTI_AGENT_MAX_ITERATIONS=4
# 竞争协作：多 Agent 并行取先确认者
#ENABLE_AGENT_RACE=true
# AI 生成式 0day：无模板漏洞走 LLM 动态生成 PoC
#ENABLE_LLM_POC=true
# 上下文管理：工具原始输出裁剪阈值（字符）
#CONTEXT_CLIP_MAX_CHARS=1500
# S1 ReActAgent 深挖接入主链路（--deep 或 env 显式控制）
#ENABLE_REACT_DIVE=true
# 每轮最多深挖参数数
#REACT_DIVE_MAX_PARAMS=3
# 每参数 ReAct 轮数
#REACT_DIVE_MAX_ITERATIONS=5
# 每参数总预算（秒）
#REACT_DIVE_BUDGET=150.0
# P2 AgentCoordinator 多智能体协调器（默认开启，120s 软截止保护）
#AGENT_COORDINATOR_ENABLED=true
# DualAgent 双智能体并行（广度+深度同时执行，默认开启，墙钟=max 不叠加）
#DUAL_AGENT_PARALLEL=true
# P5 LLM 调用指数退避（全模型轮询外的额外重试轮数，0=单轮兼容旧行为）
#LLM_RETRY_ROUNDS=2
#LLM_BACKOFF_BASE=2.0
# P3/P7 沙箱执行层（高危动作隔离；exploit_verify 联动；默认开启，后端不可用自动降级）
#SANDBOX_ENABLED=true
#SANDBOX_BACKEND=local
#SANDBOX_IMAGE=alpine:latest
#SANDBOX_MEM_LIMIT=512m
#SANDBOX_REQUIRE_FOR_BROWSER=true
# S2 跨引擎攻击链路由（SSRF->内网/Redis、上传->RCE）
#ENABLE_CHAIN_ROUTER=true
# S3 线索引擎（ReAct 深挖前预生成线索）
#ENABLE_CLUE_ENGINE=true

# ---- C组 AI 架构 ----
# C3 成本预算熔断（美元），超预算后自动降级为纯引擎模式（ai_mode=0）
#AI_COST_BUDGET_USD=0.5
#AI_COST_CIRCUIT_BREAKER=true
# A4.4 任务分层成本路由：filter 档便宜模型先粗筛，verify 档贵模型只做真验证
#FILTER_FIRST_VERIFY=true
#VERIFY_LLM_CALL_BUDGET=120
# C9 LLM-as-Judge 去重（对疑似重复 finding 用模型二次判定）
#LLM_AS_JUDGE_DEDUP=true
# C10 幻觉抑制（强制 evidence 非空且可复现，否则降级为低置信）
#HALLUCINATION_SUPPRESSION=true

# ---- E组 性能优化（增量/分档/早停/复用/分片） ----
# E2 Nuclei 模板分档（full=全量 / balanced=中危以上 / fast=仅高危）
#NUCLEI_TEMPLATE_TIER=balanced
# E3 单参数确认高危后跳过剩余低优先级引擎（早停）
#ENGINE_EARLY_STOP_ON_CONFIRMED=true
# E1 增量扫描（基于上次状态文件跳过已扫端点/参数）
#INCREMENTAL_SCAN=true
#INCREMENTAL_STATE_FILE=
# A3.2 目标画像 TTL（小时），超龄视为过期全量重扫
#ASSET_PROFILE_TTL_HOURS=168.0
# E4 请求复用（get_shared_session）开关
#REUSE_SHARED_SESSION=true
# E6 分布式分片（无 Redis 走 fakeredis 模拟）
#DISTRIBUTED_SCAN=false

# ---- H组 交付 ----
# 输出 SARIF 文件
#REPORT_SARIF=true
# 高危必带可运行 PoC
#REPORT_INCLUDE_POC=true
# 两次扫描 diff/趋势
#SCAN_DIFF=true
# 基线报告 JSON 路径
#SCAN_DIFF_BASELINE=

# ---- F组 覆盖增强 ----
# GraphQL 查询深度上限
#GRAPHQL_MAX_DEPTH=8
# BOLA/BOPLA 越权测试
#API_BOLA_TEST=true
# 组件指纹→CVE 匹配
#COMPONENT_CVE_CHECK=true

# ---- D组 爬取增强 ----
# SPA/渲染爬取
#CRAWL_RENDER_SPA=true
# JS sourceMap 分析
#CRAWL_JS_SOURCEMAP=true
# 认证后爬取
#CRAWL_AUTHED=false
# SPA hash 路由爬取
#CRAWL_HASH_ROUTING=true
# WebSocket 端点爬取
#CRAWL_WEBSOCKET=true
# TCI 自适应规划总开关
#TCI_ADAPTIVE_PLANNING=true
# 业务流建模/竞争条件总开关
#BUSINESS_FLOW_MODELING=true

# ---- 扫描覆盖 / 深度（默认最强：0=不限制；scan_profile=safe 时自动套保守上限） ----
#SCAN_PROFILE=strong
#MAX_URL_PARAMS=0
#MAX_IDOR_PARAMS=0
#MAX_FORMS=0
#MAX_JS_ENDPOINTS=0
#MAX_API_ENDPOINTS=0
#MAX_FOUND_DIRS=0
#MAX_NUCLEI_RESULTS=0
#MAX_CRAWL_ENDPOINTS=0
#MAX_PARAM_MINING=0
#MAX_CRAWL_SEED_URLS=0
#MAX_CRAWL_BATCH=0
#MAX_CRAWL_ROUNDS=8
#MAX_ITERATIVE_URLS=0
#MAX_JS_FILES=0
#MAX_INTRANET_ADDRS=0
#MAX_UPLOAD_URLS=0
#MAX_URL_POOL=0
#MAX_ENGINES_PER_PARAM=0
#MAX_TEST_PARAMS_PER_ENDPOINT=0
#MAX_BURP_HISTORY=0
#MAX_SUBDOMAINS=0
# 参数挖掘：探测侧（SCAN_PARAM_MINING）与消费侧（ENABLE_PARAM_MINING）
#SCAN_PARAM_MINING=true
#ENABLE_PARAM_MINING=true
# D4.2 采集→任务实时生成（A 线）
#LIVE_INTAKE_ENABLED=true
#LIVE_INTAKE_MIN_SCORE=8
#LIVE_INTAKE_PRIORITY=8
# SP16.1 RL 决策层（上下文多臂老虎机）
#RL_BANDIT_ENABLED=true
#RL_BANDIT_INFLUENCE=2
#RL_BANDIT_FEED_DIR=
# SP16.2 TLS 指纹伪装（curl_cffi 可选后端）
#HTTP_IMPERSONATE=true
#HTTP_IMPERSONATE_BROWSER=chrome
# SP17.3 TLS 指纹链（指纹轮换池，兼容 JSON 数组与逗号串）
#HTTP_IMPERSONATE_POOL=["chrome","firefox","safari"]
#HTTP_IMPERSONATE_ROTATE=true
# SP16.3 调用链上下文（enrich_findings 入口可达性证据增强）
#SCAN_CALLGRAPH=true
# SH17.1 阶段预算（per-phase wall-clock 上限；单阶段超时只中断本阶段跳过继续）
#PHASE_TIMEOUT_RECON_S=240
#PHASE_TIMEOUT_TASKGEN_S=60
#PHASE_TIMEOUT_SCAN_S=600
#PHASE_TIMEOUT_CHAIN_ROUTER_S=90
#PHASE_TIMEOUT_REACT_DEEP_DIVE_S=180
#PHASE_TIMEOUT_AGENT_COORDINATOR_S=120
PHASE_TIMEOUT_EXTRAS_S=480
#PHASE_TIMEOUT_VERIFY_S=120
#PHASE_TIMEOUT_REPORT_S=60
#PHASE_TIMEOUT_FALLBACK_S=180
# attack 阶段内部预算（秒，必须小于 PHASE_TIMEOUT_SCAN_S）
#ATTACK_NODE_BUDGET=500.0
# 动态补测任务（param_mining / live:*）宽限窗口（秒）
#ATTACK_DYNAMIC_GRACE_S=45.0
# Nuclei 扫描参数（原硬编码改为可调）
